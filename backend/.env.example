# Copy to `.env` and fill in real values. Never commit the real .env.

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key - full DB access, server-side only, NEVER send to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT Secret (Project Settings -> API -> JWT Settings) - used to verify user sessions
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Outscraper ---
OUTSCRAPER_API_KEY=your-outscraper-key

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID_PRO=price_your_pro_price_id

# --- Misc ---
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Email alerts (negative review notifications) ---
# Optional - if left unset, alert emails are just logged to the console
# instead of sent. Works with any standard SMTP provider (SendGrid,
# Postmark, AWS SES's SMTP interface, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@yourdomain.com
